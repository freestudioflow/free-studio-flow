{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "fsf_model_api_request_v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 131072
    },
    "parameters": {
      "type": "object"
    },
    "inputs": {
      "type": "object",
      "maxProperties": 16,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "expected_media_contract": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "prompt",
    "parameters",
    "inputs",
    "expected_media_contract"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
