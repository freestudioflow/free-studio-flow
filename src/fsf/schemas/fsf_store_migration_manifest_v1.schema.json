{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fsf_store_migration_manifest_v1",
  "description": "Versioned operator-controlled production authority contract.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "fsf_store_migration_manifest_v1"
    },
    "authorization_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "old_writers_retired": {
      "const": true
    },
    "provider_inflight_count": {
      "const": 0
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
          },
          "kind": {
            "enum": [
              "plan",
              "workflow",
              "ledger",
              "progress",
              "driver-binding"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "logical_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "source_id",
          "kind",
          "path",
          "sha256",
          "size_bytes",
          "logical_digest"
        ]
      },
      "minItems": 3
    },
    "source_scope_attestation": {
      "const": "complete_authorization_domain"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "execution_id",
          "workflow_source_id",
          "source_binding_digest"
        ],
        "properties": {
          "execution_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
          },
          "workflow_source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
          },
          "source_binding_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 68719476736
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "authorization_digest",
    "execution_ids",
    "old_writers_retired",
    "provider_inflight_count",
    "sources",
    "source_scope_attestation",
    "manifest_digest",
    "execution_bindings"
  ]
}
