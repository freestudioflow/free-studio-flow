{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "fsf_voice_receipt_v1"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lock_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "weights_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capability_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dtype": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64
    },
    "config_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "tool_lock_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "sidecars": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 256,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "outputs": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 256,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "wav": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sample_rate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "sample_rate",
        "channels",
        "sample_count"
      ],
      "additionalProperties": false
    },
    "receipt_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "request_digest",
    "lock_digest",
    "weights_sha256",
    "capability_digest",
    "dtype",
    "config_path",
    "tool_lock_path",
    "sidecars",
    "outputs",
    "wav",
    "receipt_digest"
  ],
  "additionalProperties": false
}
