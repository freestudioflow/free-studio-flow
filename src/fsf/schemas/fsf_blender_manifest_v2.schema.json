{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "fsf_blender_manifest_v2"
    },
    "identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "control_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_record_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "clock": {
      "type": "object",
      "properties": {
        "num": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24000
        },
        "den": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1001
        }
      },
      "required": [
        "num",
        "den"
      ],
      "additionalProperties": false
    },
    "frame_count": {
      "type": "integer",
      "minimum": 1
    },
    "width": {
      "type": "integer",
      "minimum": 32,
      "maximum": 512
    },
    "height": {
      "type": "integer",
      "minimum": 32,
      "maximum": 512
    },
    "profile": {
      "enum": [
        "reference",
        "clay_v1"
      ]
    },
    "tools": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "engine": {
          "const": "CYCLES"
        },
        "device": {
          "enum": [
            "CPU",
            "GPU"
          ]
        },
        "executable_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "version",
        "engine",
        "device",
        "executable_sha256",
        "runtime_sha256"
      ],
      "additionalProperties": false
    },
    "frame_mapping": {
      "type": "array",
      "minItems": 1,
      "maxItems": 192,
      "items": {
        "type": "object",
        "properties": {
          "view_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "scene_frame": {
            "type": "integer",
            "minimum": 0
          },
          "frame": {
            "type": "integer",
            "minimum": 0
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "projection": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          }
        },
        "required": [
          "view_id",
          "scene_frame",
          "frame",
          "path",
          "projection"
        ],
        "additionalProperties": false
      }
    },
    "frame_mapping_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "model",
              "reference_image",
              "control_frame",
              "control_video"
            ]
          },
          "media_type": {
            "enum": [
              "model/gltf-binary",
              "image/png",
              "video/mp4"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "path",
          "role",
          "media_type",
          "sha256",
          "size_bytes"
        ],
        "additionalProperties": false
      }
    },
    "motion_review": {
      "const": "not_reviewed"
    },
    "generation_dispatches": {
      "const": 0
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "render_profile": {
      "type": "object",
      "properties": {
        "engine": {
          "const": "CYCLES"
        },
        "device": {
          "enum": [
            "cpu",
            "gpu"
          ]
        },
        "backend": {
          "enum": [
            "none",
            "cuda"
          ]
        },
        "device_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "min_vram_mb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 131072
        },
        "samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "threads": {
          "const": 2
        }
      },
      "required": [
        "engine",
        "device",
        "backend",
        "device_count",
        "min_vram_mb",
        "samples",
        "seed",
        "threads"
      ],
      "additionalProperties": false
    },
    "execution_evidence": {
      "type": "object",
      "properties": {
        "engine": {
          "const": "CYCLES"
        },
        "device": {
          "enum": [
            "CPU",
            "GPU"
          ]
        },
        "backend": {
          "enum": [
            "none",
            "cuda"
          ]
        },
        "devices": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "type": {
                "const": "CUDA"
              }
            },
            "required": [
              "name",
              "id",
              "type"
            ],
            "additionalProperties": false
          }
        },
        "selection": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0
                },
                "uuid": {
                  "type": "string",
                  "pattern": "^GPU-[0-9a-fA-F-]{16,64}$"
                },
                "name": {
                  "type": "string"
                },
                "memory_mb": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "index",
                "uuid",
                "name",
                "memory_mb"
              ],
              "additionalProperties": false
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "uuid": {
                    "type": "string",
                    "pattern": "^GPU-[0-9a-fA-F-]{16,64}$"
                  },
                  "name": {
                    "type": "string"
                  },
                  "memory_mb": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "index",
                  "uuid",
                  "name",
                  "memory_mb"
                ],
                "additionalProperties": false
              }
            }
          ]
        },
        "device_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      },
      "required": [
        "engine",
        "device",
        "backend",
        "devices",
        "selection"
      ],
      "additionalProperties": false
    },
    "encode_profile": {
      "type": "object",
      "properties": {
        "profile": {
          "const": "rc8_control_x264_v1"
        },
        "device": {
          "const": "cpu"
        },
        "encoder": {
          "const": "libx264"
        },
        "ffmpeg_version": {
          "const": "8.0.1"
        },
        "ffmpeg_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ffmpeg_build_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "libx264_build": {
          "type": "string",
          "pattern": "^core [0-9]+(?: r[0-9]+ [0-9a-f]{7,40})?$",
          "maxLength": 256
        }
      },
      "required": [
        "profile",
        "device",
        "encoder",
        "ffmpeg_version",
        "ffmpeg_sha256",
        "ffmpeg_build_digest",
        "libx264_build"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "identity",
    "control_id",
    "revision",
    "request_digest",
    "source_record_digest",
    "clock",
    "frame_count",
    "width",
    "height",
    "profile",
    "tools",
    "frame_mapping",
    "frame_mapping_digest",
    "artifacts",
    "motion_review",
    "generation_dispatches",
    "manifest_digest",
    "render_profile",
    "execution_evidence",
    "encode_profile"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
