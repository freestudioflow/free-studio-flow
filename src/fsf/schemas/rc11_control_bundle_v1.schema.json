{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "rc11_control_bundle_v1"
    },
    "control_asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "clock": {
      "type": "object",
      "properties": {
        "num": {
          "type": "integer",
          "minimum": 1
        },
        "den": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "num",
        "den"
      ],
      "additionalProperties": false
    },
    "frame_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 172800
    },
    "width": {
      "type": "integer",
      "minimum": 32,
      "maximum": 3840,
      "multipleOf": 2
    },
    "height": {
      "type": "integer",
      "minimum": 32,
      "maximum": 3840,
      "multipleOf": 2
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
          },
          "kind": {
            "enum": [
              "rgb",
              "depth",
              "normal",
              "edge",
              "pose",
              "custom"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "source_method": {
            "enum": [
              "analytic_ray_cast",
              "renderer_pass",
              "external"
            ]
          },
          "encoding": {
            "enum": [
              "png_rgb8",
              "png_gray8",
              "float32_le",
              "pose_json_v1",
              "opaque"
            ]
          },
          "semantics": {
            "type": "object"
          },
          "semantics_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "manifest": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 68719476736
              }
            },
            "required": [
              "path",
              "sha256",
              "size_bytes"
            ],
            "additionalProperties": false
          },
          "provenance": {
            "type": "object",
            "properties": {
              "producer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "binary_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              },
              "qualification": {
                "enum": [
                  "declared",
                  "observed"
                ]
              }
            },
            "required": [
              "producer",
              "version",
              "binary_sha256",
              "qualification"
            ],
            "additionalProperties": false
          },
          "clock": {
            "type": "object",
            "properties": {
              "num": {
                "type": "integer",
                "minimum": 1
              },
              "den": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "num",
              "den"
            ],
            "additionalProperties": false
          },
          "width": {
            "type": "integer",
            "minimum": 32,
            "maximum": 3840,
            "multipleOf": 2
          },
          "height": {
            "type": "integer",
            "minimum": 32,
            "maximum": 3840,
            "multipleOf": 2
          },
          "frame_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 172800
          },
          "mapping_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "kind",
          "required",
          "source_method",
          "encoding",
          "semantics",
          "semantics_digest",
          "manifest",
          "provenance",
          "clock",
          "width",
          "height",
          "frame_count",
          "mapping_digest"
        ],
        "additionalProperties": false
      }
    },
    "mapping_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bundle_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "control_asset_id",
    "clock",
    "frame_count",
    "width",
    "height",
    "channels",
    "mapping_digest",
    "bundle_digest"
  ],
  "additionalProperties": false
}
