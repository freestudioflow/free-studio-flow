{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "fsf_segment_delivery_receipt_v1"
    },
    "delivery_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution": {
      "const": "completed"
    },
    "motion_review": {
      "const": "not_reviewed"
    },
    "receipt_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "delivery_digest",
    "plan_digest",
    "artifact_sha256",
    "execution",
    "motion_review",
    "receipt_digest"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
