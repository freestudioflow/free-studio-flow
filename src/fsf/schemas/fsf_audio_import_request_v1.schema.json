{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "fsf_audio_import_request_v1"
    },
    "edit_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "base_revision": {
      "type": "integer",
      "minimum": 1
    },
    "base_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "audio_source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "resource_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "stream_index": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "audio_source_id",
          "resource_id",
          "relative_path",
          "stream_index"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "edit_id",
    "base_revision",
    "base_digest",
    "selections"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fsf_audio_import_request_v1"
}
