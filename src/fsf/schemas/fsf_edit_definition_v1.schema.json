{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Edit creation definition; source declarations are not QC authority",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "fsf_edit_definition_v1"
    },
    "edit_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "clock_rate": {
      "type": "object",
      "properties": {
        "num": {
          "type": "integer",
          "minimum": 1
        },
        "den": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "num",
        "den"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "shot_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "label": {
            "type": "string"
          },
          "duration_frames": {
            "type": "integer",
            "minimum": 1
          },
          "source_ref": {
            "type": "object",
            "properties": {
              "source_execution_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "source_job_id": {
                "type": "string",
                "minLength": 1
              },
              "source_run_id": {
                "type": "string",
                "minLength": 1
              },
              "source_plan_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "source_journal_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "producer_step_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "artifact_ref": {
                "type": "string",
                "minLength": 1
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "purpose": {
                "const": "video"
              }
            },
            "required": [
              "source_execution_id",
              "source_job_id",
              "source_run_id",
              "source_plan_digest",
              "source_journal_digest",
              "producer_step_id",
              "artifact_ref",
              "artifact_sha256",
              "purpose"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "source_id",
          "shot_id",
          "label",
          "duration_frames",
          "source_ref"
        ],
        "additionalProperties": false
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "clip_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "label": {
            "type": "string"
          },
          "in_frame": {
            "type": "integer",
            "minimum": 0
          },
          "out_frame": {
            "type": "integer",
            "minimum": 1
          },
          "lineage": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "clip_id",
          "source_id",
          "label",
          "in_frame",
          "out_frame",
          "lineage"
        ],
        "additionalProperties": false
      }
    },
    "audio_tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "track_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "role": {
            "enum": [
              "source",
              "vo",
              "bgm",
              "sfx"
            ]
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "track_id",
          "role",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "subtitle_tracks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "schema_version": {
                "const": "fsf_edit_subtitle_track_v1"
              },
              "track_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "clock_rate": {
                "type": "object",
                "properties": {
                  "num": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "den": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "num",
                  "den"
                ],
                "additionalProperties": false
              },
              "timebase": {
                "const": "clip_relative"
              },
              "cues": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "cue_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                    },
                    "start_frame": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end_frame": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "clip_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                    }
                  },
                  "required": [
                    "cue_id",
                    "start_frame",
                    "end_frame",
                    "text",
                    "clip_id"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "schema_version",
              "track_id",
              "clock_rate",
              "timebase",
              "cues"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "schema_version": {
                "const": "fsf_edit_subtitle_track_v1"
              },
              "track_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "clock_rate": {
                "type": "object",
                "properties": {
                  "num": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "den": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "num",
                  "den"
                ],
                "additionalProperties": false
              },
              "timebase": {
                "const": "timeline_absolute"
              },
              "timing_anchor_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "cues": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "cue_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                    },
                    "start_frame": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end_frame": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "cue_id",
                    "start_frame",
                    "end_frame",
                    "text"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "schema_version",
              "track_id",
              "clock_rate",
              "timebase",
              "timing_anchor_digest",
              "cues"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "edit_id",
    "clock_rate",
    "sources",
    "clips"
  ],
  "additionalProperties": false
}
