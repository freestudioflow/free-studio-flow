{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fsf_asr_command_v1",
  "description": "Operator-selected ASR command and immutable model binding. Paths, executable pinning and canonical digest are also checked at runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authorized", "settings", "model_lock_digest", "recognizer_digest"],
  "properties": {
    "schema_version": {"const": "fsf_asr_command_v1"},
    "authorized": {"type": "boolean"},
    "model_lock_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recognizer_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "files", "cwd", "timeout_seconds", "credential_env_names"],
      "properties": {
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cwd": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 5400},
        "credential_env_names": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
        },
        "files": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    }
  }
}
