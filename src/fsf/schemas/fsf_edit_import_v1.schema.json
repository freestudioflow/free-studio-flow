{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "fsf_edit_import_v1"
    },
    "edit_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "clock_rate": {
      "type": "object",
      "properties": {
        "num": {
          "type": "integer",
          "minimum": 1
        },
        "den": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "num",
        "den"
      ],
      "additionalProperties": false
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "source_execution_id": {
            "type": "string",
            "minLength": 1
          },
          "producer_step_id": {
            "type": "string",
            "minLength": 1
          },
          "artifact_ref": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_execution_id",
          "producer_step_id",
          "artifact_ref"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "edit_id",
    "clock_rate",
    "selections"
  ],
  "additionalProperties": false
}
