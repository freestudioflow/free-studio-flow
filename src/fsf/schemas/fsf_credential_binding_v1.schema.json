{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "source", "reference", "revision", "authorized", "resolver"],
  "properties": {
    "schema_version": {"const": "fsf_credential_binding_v1"},
    "profile_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "source": {"enum": ["environment", "aws_default_chain", "os_credential_store", "host_secret_manager", "host_proxy"]},
    "reference": {"type": "string", "minLength": 1, "maxLength": 512},
    "revision": {"type": "string", "minLength": 1, "maxLength": 512},
    "authorized": {"type": "boolean"},
    "resolver": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 1, "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}}]}
  }
}
