{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "fsf_post_receipt_v1"
    },
    "edit_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "edit_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "post_plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "clip_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "label": {
            "type": "string"
          },
          "in_frame": {
            "type": "integer",
            "minimum": 0
          },
          "out_frame": {
            "type": "integer",
            "minimum": 1
          },
          "lineage": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "clip_id",
          "source_id",
          "label",
          "in_frame",
          "out_frame",
          "lineage"
        ],
        "additionalProperties": false
      }
    },
    "clock_rate": {
      "type": "object",
      "properties": {
        "num": {
          "type": "integer",
          "minimum": 1
        },
        "den": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "num",
        "den"
      ],
      "additionalProperties": false
    },
    "total_frames": {
      "type": "integer",
      "minimum": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "tool_version": {
      "type": "string"
    },
    "qc_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "visual_review": {
      "const": "not_evaluated"
    },
    "receipt_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "edit_id",
    "revision",
    "edit_digest",
    "post_plan_digest",
    "source_manifest_digest",
    "clips",
    "clock_rate",
    "total_frames",
    "files",
    "tool_version",
    "qc_digest",
    "visual_review",
    "receipt_digest"
  ],
  "additionalProperties": false
}
