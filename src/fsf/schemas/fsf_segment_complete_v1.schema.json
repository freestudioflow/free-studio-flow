{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "fsf_segment_complete_v1"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generation_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "segment": {
      "type": "object",
      "properties": {
        "segment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "end_frame": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "segment_id",
        "start_frame",
        "end_frame"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "attempt_id": {
      "type": "integer",
      "minimum": 1
    },
    "result_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "frame_mapping_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "frame_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 96
    },
    "motion_review": {
      "const": "not_reviewed"
    },
    "complete_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "plan_digest",
    "generation_digest",
    "segment",
    "request_digest",
    "attempt_id",
    "result_digest",
    "manifest_digest",
    "frame_mapping_digest",
    "frame_count",
    "motion_review",
    "complete_digest"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
