{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "fsf_remote_profile_v1"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
    },
    "transport": {
      "enum": [
        "local",
        "http",
        "ssh",
        "kaggle"
      ]
    },
    "authorized": {
      "type": "boolean"
    },
    "approved_recipes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "policy": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "gpu": {
          "type": "boolean"
        },
        "ram_mb": {
          "type": "integer",
          "minimum": 128,
          "maximum": 65536
        },
        "disk_mb": {
          "type": "integer",
          "minimum": 64,
          "maximum": 65536
        },
        "deadline_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "network_sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 0,
          "maxItems": 32
        },
        "credential_env_names": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      },
      "required": [
        "cpu",
        "gpu",
        "ram_mb",
        "disk_mb",
        "deadline_seconds",
        "network_sources",
        "credential_env_names"
      ],
      "additionalProperties": false
    },
    "settings": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "transport",
    "authorized",
    "approved_recipes",
    "policy",
    "settings"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
