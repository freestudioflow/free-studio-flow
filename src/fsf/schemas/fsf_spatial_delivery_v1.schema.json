{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fsf_spatial_delivery_v1",
  "description": "FSF local spatial asset delivery, without device tracking attestation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "fsf_spatial_delivery_v1"
    },
    "pack_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "meters_per_unit": {
      "const": 1
    },
    "handedness": {
      "const": "right"
    },
    "up": {
      "const": "+Y"
    },
    "authored_front": {
      "const": "+Z"
    },
    "root_transform_column_major": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 16,
      "maxItems": 16
    },
    "ground_plane": {
      "const": [
        0,
        1,
        0,
        0
      ]
    },
    "placement_mode": {
      "enum": [
        "local_ground",
        "local_origin"
      ]
    },
    "local_anchor_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "target_consumer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
          },
          "scene_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "node_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "pivot_m": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "expected_bounds_m": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minimum": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "maximum": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": [
              "minimum",
              "maximum"
            ]
          },
          "collision_mode": {
            "enum": [
              "none",
              "convex",
              "static_trimesh"
            ]
          }
        },
        "required": [
          "object_id",
          "scene_index",
          "node_index",
          "pivot_m",
          "expected_bounds_m",
          "collision_mode"
        ]
      },
      "minItems": 1
    },
    "spatial_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "pack_digest",
    "profile_digest",
    "meters_per_unit",
    "handedness",
    "up",
    "authored_front",
    "root_transform_column_major",
    "ground_plane",
    "placement_mode",
    "local_anchor_id",
    "target_consumer",
    "objects",
    "spatial_digest"
  ]
}
