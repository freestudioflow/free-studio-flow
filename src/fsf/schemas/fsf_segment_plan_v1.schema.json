{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "fsf_segment_plan_v1"
    },
    "group_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
    },
    "clock": {
      "type": "object",
      "properties": {
        "num": {
          "type": "integer",
          "minimum": 1
        },
        "den": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "num",
        "den"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "start_frame": {
      "type": "integer",
      "minimum": 0
    },
    "end_frame": {
      "type": "integer",
      "minimum": 1
    },
    "generation": {
      "type": "object",
      "properties": {
        "template_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_manifest_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recipe_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "worker_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "animation_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "render_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "template_digest",
        "source_manifest_digest",
        "recipe_digest",
        "worker_digest",
        "animation_digest",
        "render_digest"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "generation_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "encoder_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "segment_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
          },
          "start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "end_frame": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "segment_id",
          "start_frame",
          "end_frame"
        ],
        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "minItems": 1,
      "maxItems": 128
    },
    "budget_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "max_attempts_per_segment": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "max_total_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "group_id",
    "clock",
    "start_frame",
    "end_frame",
    "generation",
    "generation_digest",
    "encoder_digest",
    "segments",
    "budget_seconds",
    "max_attempts_per_segment",
    "max_total_attempts",
    "plan_digest"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
