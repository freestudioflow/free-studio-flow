{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fsf_model_capability_v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "fsf_model_capability_v1"
    },
    "model_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "model_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runner_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qualification": {
      "enum": [
        "unverified",
        "verified"
      ]
    },
    "qualification_evidence_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "modalities": {
      "type": "array",
      "items": {
        "enum": [
          "control_video",
          "text",
          "image"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "clocks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "num": {
                "const": 24
              },
              "den": {
                "const": 1
              }
            },
            "required": [
              "num",
              "den"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "num": {
                "const": 24000
              },
              "den": {
                "const": 1001
              }
            },
            "required": [
              "num",
              "den"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 32,
            "maximum": 3840
          },
          {
            "type": "integer",
            "minimum": 32,
            "maximum": 3840
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "max_frames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 172800
    },
    "frame_step": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "overlap_frames": {
      "type": "integer",
      "minimum": 0,
      "maximum": 172799
    },
    "continuation": {
      "enum": [
        "independent",
        "previous_frame"
      ]
    },
    "tail_padding": {
      "enum": [
        "refuse",
        "repeat_last_explicit"
      ]
    },
    "capability_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "model_id",
    "model_revision",
    "runner_digest",
    "environment_digest",
    "qualification",
    "qualification_evidence_digest",
    "modalities",
    "clocks",
    "dimensions",
    "max_frames",
    "frame_step",
    "overlap_frames",
    "continuation",
    "tail_padding",
    "capability_digest"
  ],
  "additionalProperties": false
}
