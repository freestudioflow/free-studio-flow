{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "fsf_remote_result_v2"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recipe_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "worker_core_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parent": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "step_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "attempt_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inputs_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected_contract_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "requirements_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "job_id",
        "run_id",
        "step_id",
        "attempt_id",
        "plan_digest",
        "inputs_digest",
        "expected_contract_digest",
        "requirements_digest"
      ],
      "additionalProperties": false
    },
    "child": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "attempt_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "plan": {
          "type": "object"
        }
      },
      "required": [
        "job_id",
        "run_id",
        "attempt_id",
        "plan"
      ],
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "properties": {
        "group_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "segment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "generation_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "end_frame": {
          "type": "integer",
          "minimum": 1
        },
        "clock": {
          "type": "object",
          "properties": {
            "num": {
              "type": "integer",
              "minimum": 1
            },
            "den": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "num",
            "den"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "group_id",
        "segment_id",
        "generation_digest",
        "start_frame",
        "end_frame",
        "clock"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "error_code": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
          },
          "reference": {
            "type": "object",
            "properties": {
              "artifact_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
              },
              "store_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
              },
              "object_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "version_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 21474836480
              },
              "role": {
                "enum": [
                  "video",
                  "audio",
                  "control_video",
                  "control_frame",
                  "model",
                  "scene",
                  "reference_image",
                  "data",
                  "worker_wheel"
                ]
              },
              "media_type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "artifact_id",
              "store_id",
              "object_key",
              "version_id",
              "sha256",
              "size_bytes",
              "role",
              "media_type"
            ],
            "additionalProperties": false,
            "$schema": "https://json-schema.org/draft/2020-12/schema"
          }
        },
        "required": [
          "artifact_id",
          "reference"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    },
    "environment_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "child_journal_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "condition_acknowledgement": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "consistency_acknowledgement": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "motion_review": {
      "const": "not_reviewed"
    },
    "result_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "request_digest",
    "recipe_digest",
    "worker_core_sha256",
    "parent",
    "child",
    "segment",
    "status",
    "error_code",
    "artifacts",
    "environment_digest",
    "child_journal_sha256",
    "condition_acknowledgement",
    "consistency_acknowledgement",
    "motion_review",
    "result_digest"
  ],
  "additionalProperties": false
}
