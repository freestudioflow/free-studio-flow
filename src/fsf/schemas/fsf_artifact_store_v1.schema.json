{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "fsf_artifact_store_v1"
    },
    "store_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
    },
    "authorized": {
      "type": "boolean"
    },
    "endpoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "region": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "bucket": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "read_prefixes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "minItems": 1,
      "maxItems": 32
    },
    "write_prefixes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "minItems": 1,
      "maxItems": 32
    },
    "max_artifact_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 21474836480
    },
    "max_total_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 107374182400
    },
    "deadline_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "credential_mode": {
      "enum": [
        "aws_default_chain",
        "bindings"
      ]
    },
    "credential_bindings": {
      "type": "object",
      "properties": {
        "access_key": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "secret_key": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "session_token": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "access_key",
        "secret_key",
        "session_token"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "store_id",
    "authorized",
    "endpoint",
    "region",
    "bucket",
    "read_prefixes",
    "write_prefixes",
    "max_artifact_bytes",
    "max_total_bytes",
    "deadline_seconds",
    "credential_mode",
    "credential_bindings"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
