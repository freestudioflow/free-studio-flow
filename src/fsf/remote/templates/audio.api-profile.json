{
  "schema_version": "fsf_model_api_profile_v1",
  "profile_id": "custom_audio",
  "protocol": "json_http_v1",
  "capability": "audio",
  "model": "MODEL_ID",
  "authorized": false,
  "base_url": "https://worker.example.invalid/v1",
  "key_env": "FSF_MODEL_API_KEY",
  "region": null,
  "allow_loopback": false,
  "artifact_hosts": [],
  "timeout_seconds": 120,
  "max_tokens": 64,
  "parameter_schema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "http": {
    "auth_header": "Authorization",
    "routes": {
      "submit": "/audio",
      "status": null,
      "fetch": null,
      "reconcile": null,
      "cancel": null,
      "check": "/capabilities"
    },
    "body": {
      "model": "{model}",
      "prompt": "{prompt}"
    },
    "response_mode": "binary",
    "result_pointer": "/output",
    "job_id_pointer": null,
    "status_pointer": null,
    "status_map": {
      "queued": "queued",
      "running": "running",
      "completed": "completed",
      "failed": "failed",
      "cancelled": "cancelled"
    }
  },
  "output": {
    "media_type": "audio/wav",
    "suffix": ".wav",
    "max_bytes": 8388608,
    "max_dimension": 2048,
    "max_duration_seconds": 30
  }
}
