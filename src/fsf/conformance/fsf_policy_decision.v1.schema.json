{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freestudioflow.dev/schemas/fsf_policy_decision.v1.json",
  "title": "FSF policy decision v1",
  "description": "Host policy refusal. Not a PDX media conformance report; must not create an Engine binding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision",
    "reason_code",
    "location",
    "message",
    "issues",
    "interpretation"
  ],
  "properties": {
    "schema_version": {"const": "fsf_policy_decision_v1"},
    "decision": {"enum": ["refuse"]},
    "reason_code": {"type": "string", "minLength": 1, "maxLength": 128},
    "location": {"type": "string", "minLength": 1, "maxLength": 512},
    "message": {"type": "string", "minLength": 1, "maxLength": 1024},
    "issues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "location", "message", "retryable"],
        "properties": {
          "code": {"type": "string", "minLength": 1, "maxLength": 128},
          "location": {"type": "string", "minLength": 1, "maxLength": 512},
          "message": {"type": "string", "minLength": 1, "maxLength": 1024},
          "retryable": {"type": "boolean"}
        }
      }
    },
    "interpretation": {"const": "none"}
  }
}
